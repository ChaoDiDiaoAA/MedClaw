+/** Product-managed registration: no ambient discovery, user files, RPC, scheduling or UI. */
+export function createManagedAgentExtension(bridge: import("./agent-runner.js").ManagedAgentSessionBridge) {
+  const manager = new AgentManager();
+  manager.retainManagedRecords();
+  manager.setMaxConcurrentForeground(4);
+  const occupied = new Map<string, string | undefined>();
+  let closed = false;
+  const factory: import("@earendil-works/pi-coding-agent").ExtensionFactory = pi => {
+    pi.registerCommand("subagent", { description: "Delegate a foreground read-only task to a verified MedClaw role.",
+      async handler(args) {
+        if (closed || !bridge.onCommand) throw new Error("state_conflict");
+        const match = /^([a-z0-9]+(?:-[a-z0-9]+)*)[ \t]+([\s\S]+)$/.exec(args);
+        if (!match || match[1].length > 64 || !match[2].trim() || match[2].length > 65536) throw new Error("invalid_argument");
+        bridge.onCommand({ roleId: match[1], task: match[2] });
+      },
+    });
+    pi.registerTool(defineTool({
+      name: "Agent", label: "Agent", description: "Delegate a foreground read-only verification with independent context.", executionMode: "parallel",
+      parameters: Type.Object({
+        prompt: Type.String({ minLength: 1, maxLength: 65536 }),
+        description: Type.String({ minLength: 1, maxLength: 256 }),
+        subagent_type: Type.Optional(Type.String({ minLength: 1, maxLength: 128, pattern: "^[a-z0-9]+(?:-[a-z0-9]+)*$" })),
+        run_in_background: Type.Optional(Type.Literal(false)),
+      }, { additionalProperties: false }),
+      async execute(_toolCallId, params, signal, onUpdate, ctx) {
+        const keys = Object.keys(params);
+        if (keys.some(key => !["prompt", "description", "subagent_type", "run_in_background"].includes(key))
+          || typeof params.prompt !== "string" || !params.prompt.length || params.prompt.length > 65536
+          || typeof params.description !== "string" || !params.description.length || params.description.length > 256
+          || params.subagent_type !== undefined && (typeof params.subagent_type !== "string" || params.subagent_type.length > 128 || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(params.subagent_type))
+          || params.run_in_background !== undefined && params.run_in_background !== false) throw new Error("tool_input_invalid");
+        if (typeof _toolCallId !== "string" || !_toolCallId.length) throw new Error("tool_input_invalid");
+        if (closed || occupied.size >= 4 || occupied.has(_toolCallId)) throw new Error("runtime_busy");
+        signal?.throwIfAborted();
+        const maxTurns = bridge.getMaxTurns();
+        if (!Number.isSafeInteger(maxTurns) || maxTurns < 1) throw new Error("agent_call_limit");
+        occupied.set(_toolCallId, undefined);
+        const roleId = params.subagent_type ?? "medclaw-audit";
+        const invocation: AgentInvocation = { isolated: true, inheritContext: false, runInBackground: false, isolation: "off", maxTurns };
+        try { return await executeForegroundAgent(manager, pi, ctx, params, {
+          subagentType: roleId, effectiveMaxTurns: maxTurns, isolated: true, inheritContext: false,

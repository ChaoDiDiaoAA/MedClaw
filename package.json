{
  "name": "medclaw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/desktop", "apps/host", "packages/contracts", "packages/core", "packages/runtime-pi", "packages/storage", "packages/logging", "packages/intent-ollama", "agent-eval"],
  "scripts": {
    "build:desktop": "bun apps/desktop/build.ts",
    "package:desktop": "bun run build:desktop && electron-builder --config apps/desktop/electron-builder.config.ts --win nsis --x64 --publish never",
    "eval": "bun --no-env-file agent-eval/src/cli.ts",
    "eval:smoke": "bun --no-env-file agent-eval/src/presets.ts smoke",
    "eval:full": "bun --no-env-file agent-eval/src/presets.ts full",
    "eval:upload": "bun --no-env-file agent-eval/src/presets.ts upload",
    "test:eval": "bun test agent-eval/tests",
    "typecheck": "tsc --noEmit",
    "dev:desktop": "bun apps/desktop/dev.ts",
    "test:unit": "bun tests/run.ts unit",
    "test:integration": "bun tests/run.ts integration",
    "test:e2e": "bun --no-env-file tests/run.ts e2e",
    "test:e2e:desktop": "bun --no-env-file tests/run.ts desktop"
  },
  "devDependencies": {
    "electron-builder": "26.15.3",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@earendil-works/pi-telemetry": "0.87.1",
    "@earendil-works/chord": "0.87.1"
  },
  "trustedDependencies": ["electron"],
  "patchedDependencies": {
    "@tintinweb/pi-subagents@0.19.0": "patches/@tintinweb%2Fpi-subagents@0.19.0.patch"
  }
}
